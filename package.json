{
  "name": "movieweb",
  "version": "1.0.0",
  "description": "MovieWeb - monorepo (API Express + Angular) orquestado con Turborepo",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "api",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run dev",
    "dev:setup": "npm run db:setup -w api",
    "dev:reset": "npm run db:setup -w api -- --reset",
    "db:drop": "npm run db:setup -w api -- --drop",
    "build": "turbo run build",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "license": "ISC"
}
